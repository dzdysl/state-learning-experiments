    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#6B7280">
      <TR><TD COLSPAN="9" BGCOLOR="#F3F4F6"><B>图例</B></TD></TR>
      <TR><TD><FONT COLOR="#2E8B57">━━▶</FONT></TD><TD ALIGN="LEFT">绿色：真正拆分</TD><TD><FONT COLOR="#E67E22">━━▶</FONT></TD><TD ALIGN="LEFT">橙色：成员不变，仅编号变化</TD><TD><FONT COLOR="#9AA0A6">──▶</FONT></TD><TD ALIGN="LEFT">灰色：名称和成员均不变</TD><TD></TD><TD></TD><TD></TD></TR>
      <TR><TD BGCOLOR="#DCEBFF"><B>A 类</B></TD><TD BGCOLOR="#FFE1E1"><B>D 类</B></TD><TD BGCOLOR="#DFF3E4"><B>N 类</B></TD><TD BGCOLOR="#EBDDFA"><B>NG 类</B></TD><TD BGCOLOR="#FFF0BD"><B>S 类</B></TD><TD BGCOLOR="#DDF5F7"><B>R 类</B></TD><TD BGCOLOR="#ECEFF1"><B>X 类</B></TD><TD COLSPAN="2" ALIGN="LEFT">横向顺序：A → D → N → NG → S → R → X</TD></TR>
    </TABLE>
  >];
  { rank=sink; legend; }
  round_4 -> legend [style=invis, weight=200];

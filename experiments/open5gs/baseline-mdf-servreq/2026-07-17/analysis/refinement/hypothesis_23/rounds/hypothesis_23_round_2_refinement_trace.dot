digraph G {
graph [rankdir=LR, bgcolor="white", fontname="Microsoft YaHei", labelloc="t", label="第 2 轮细化溯源图", fontsize=20, pad=0.25, nodesep=0.35, ranksep=0.7];
node [shape=box, style="rounded,filled", fontname="Microsoft YaHei", fontsize=11, color="#455a64", margin="0.10,0.07"];
edge [fontname="Microsoft YaHei", fontsize=9, color="#607d8b"];
subgraph cluster_1 {
label="父类 A1"; color="#90a4ae"; style="rounded";
p_1 [label="A1（上一轮）\\n{s3, s20}" fillcolor="#fff9c4" penwidth=1.5];
c_1_1 [label="A1\\n{s3}" fillcolor="#fff9c4"];
p_1 -> c_1_1 [label="基准 signature"];
c_1_2 [label="A2\\n{s20}" fillcolor="#fff9c4"];
p_1 -> c_1_2 [label="deregistrationRequest: D1→D4"];
}
subgraph cluster_2 {
label="父类 N1"; color="#90a4ae"; style="rounded";
p_2 [label="N1（上一轮）\\n{s1, s11, s14, s19, s21, s24}" fillcolor="#bbdefb" penwidth=1.5];
c_2_1 [label="N1\\n{s1, s24}" fillcolor="#bbdefb"];
p_2 -> c_2_1 [label="基准 signature"];
c_2_2 [label="N2\\n{s11, s14}" fillcolor="#bbdefb"];
p_2 -> c_2_2 [label="authenticationResponse: A1→A3"];
c_2_3 [label="N3\\n{s19}" fillcolor="#bbdefb"];
p_2 -> c_2_3 [label="deregistrationRequest: D1→D4"];
c_2_4 [label="N4\\n{s21}" fillcolor="#bbdefb"];
p_2 -> c_2_4 [label="deregistrationRequest: D1→D4\\nauthenticationResponse: A1→A4"];
}
}

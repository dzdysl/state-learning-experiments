__start0 [label="" shape="none" width="0" height="0"];
__start0 -> s0;


  // Closure edges and self-loops used by the base group.
  s1 -> s0 [label="deregistrationRequest / null_action", color="#7E57C2", fontcolor="black", style="dashed", penwidth=4.0, tooltip="S008", constraint=false];
